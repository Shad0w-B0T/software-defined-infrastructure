hcloud_token = "<your_hcloud_api_token>"
dns_zone = "<your_dns_zone>"             # e.g., "g3.sdi.hdm-stuttgart.cloud"
server_name = "<your_server_name>"       # e.g., "workhorse"
server_aliases = [
  "<alias1>",                            # e.g., "www"
  "<alias2>"                             # e.g., "mail"
]
dns_key_name = "<your_dns_key_name>"     # e.g., "g3.key."
dns_secret   = "<your_dns_secret>"       # Base64 or plain secret
contact_mail = "<your_contact_email>"    # e.g., "me@example.com"
public_key = "<your_ssh_public_key>"     # e.g., "ssh-ed25519 AAAA... user@host"
