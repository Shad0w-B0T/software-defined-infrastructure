hcloud_token = "<your_hcloud_token>"  # e.g., "EXxxxx..."
dns_zone = "<your_dns_zone>"          # e.g., "g3.sdi.hdm-stuttgart.cloud"
server_name = "<your_server_name>"    # e.g., "workhorse"
server_aliases = [
  "<alias1>",                         # e.g., "www"
  "<alias2>"                          # e.g., "mail"
]
dns_key_name = "<your_dns_key_name>"  # e.g., "g3.key."
dns_secret   = "<your_dns_secret>"    # e.g., base64 or plaintext secret
contact_mail = "<your_email_address>" # e.g., "you@example.com"
